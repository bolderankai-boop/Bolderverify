{
  "name": "bolderank-verify",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --local --ip 127.0.0.1",
    "db:local": "wrangler d1 migrations apply bolderank-local --local",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts && node --test test/*.test.js",
    "verify": "tsx scripts/verify.ts",
    "legacy": "node serve.mjs",
    "dev:local": "node --env-file=.dev.vars --import tsx scripts/dev.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.2"
  },
  "packageManager": "pnpm@11.25.0"
}
